# Normalize line endings; scripts must stay LF even on Windows.
* text=auto eol=lf
*.sh text eol=lf
justfile text eol=lf
*.ps1 text eol=crlf
*.bat text eol=crlf
*.cmd text eol=crlf

# Binary files
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.webp binary
*.ico binary
*.pdf binary
*.zip binary
*.gz binary
*.mp4 binary
*.woff binary
*.woff2 binary
*.tsr binary
*.ots binary

# Generated or reference files
llms-full.txt linguist-generated=true
docs/build-standard.md linguist-documentation=true
scripts/audit-checks.tsv linguist-generated=true
